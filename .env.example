# Copy this file to .env and fill in your Formspree form ID
# (create a free form at https://formspree.io → paste the ID below)
# "Get Listed" submissions will then be emailed to you automatically.
VITE_FORMSPREE_ID=

# No .env needed for production: `npm run build:vercel` (used on Vercel) sets
# VITE_DATA_URL=/api/directory inline so the app loads the dataset through the
# guarded serverless endpoint. Local dev/build uses the public dev file.
